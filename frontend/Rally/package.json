  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/cli": "^58.1.14",
    "@testing-library/react": "^14.3.1",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "~12.0.0",
    "detox": "^20.41.1",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }

{
  "name": "rally",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "start": "expo start",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build:web:dev": "expo export --platform web",
    "test": "jest",
    "test:e2e": "detox test --configuration android.emu.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "build:e2e:ios": "detox build --configuration ios.sim.debug",
    "build:e2e:android": "detox build --configuration android.emu.debug",
    "e2e:ci": "detox test --configuration android.emu.debug --cleanup"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "~3.1.1",
    "@react-native-community/datetimepicker": "^9.2.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.8.2",
    "expo": "~58.0.17",
    "expo-application": "~58.1.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-haptics": "^58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.6",
    "expo-status-bar": "~58.0.4",
    "memoize-one": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.0",
    "react-native-chart-kit": "^7.0.4",
    "react-native-elements": "^3.4.3",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-get-random-values": "~2.0.0",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.4",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1"

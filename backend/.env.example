# Environment Configuration
# Copy this file to .env and update with your actual values

# Application
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/badminton_dev

# JWT Configuration
# In production both secrets are REQUIRED and must be at least 32 characters,
# otherwise the server refuses to start (fail-fast). Generate strong values with:
#   openssl rand -hex 32
# In development/test they are optional: if unset, a random per-process secret is
# used and a warning is logged (issued tokens will not survive a restart).
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis Configuration (optional)
# When REDIS_URL is unset the app uses an in-memory cache (dev/test default).
# Redis is best-effort: an outage degrades to the memory cache, never a 5xx.
REDIS_URL=redis://localhost:6379
# Namespace prefixed to every cache key (default: rally:cache:)
REDIS_KEY_PREFIX=rally:cache:
# Max size (bytes) of a single cache entry; larger values are skipped (default: 262144 = 256 KB)
CACHE_MAX_ENTRY_BYTES=262144
# Redis client connect timeout (ms) and max backoff retries
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=10

# Frontend URL (for share links)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
# Correlation ID header name (default: x-request-id)
CORRELATION_ID_HEADER=x-request-id

# Metrics / Observability (Story 6.3)
# Enable Prometheus-compatible metrics endpoint (default: true in production, false otherwise)
METRICS_ENABLED=false
# Port for the metrics scrape endpoint (default: 9090)
METRICS_PORT=9090
# Path for metrics endpoint (default: /metrics)
METRICS_PATH=/metrics
# Bearer token for accessing /metrics (required when METRICS_ENABLED=true)
# In production this is REQUIRED and must be at least 32 characters.
# In development/test it is optional: if unset, a random per-process token is used.
METRICS_AUTH_TOKEN=your-metrics-auth-token-change-this-in-production-min-32-chars

# Socket.io Real-Time Configuration (Story 6.4)
# Adapter used for horizontal scaling: 'redis' shares socket state across
# server instances; 'memory' is the single-instance / local-dev default.
# When unset it is inferred: redis if REDIS_URL is present, else memory.
SOCKET_ADAPTER=memory
# Redis URL for the adapter's pub/sub client pair (defaults to REDIS_URL)
SOCKET_REDIS_URL=redis://localhost:6379
# Grace period (ms) before a disconnected socket flips presence offline
SOCKET_PATIENCE_MS=5000
# Reconnect: max events replayed before the client is told to refetch full state
SOCKET_MAX_REPLAY_EVENTS=10
# Bounded per-room event ring used for reconnect replay
SOCKET_EVENT_BUFFER_SIZE=200

# Security
BCRYPT_ROUNDS=12

# Development specific
DEV_DATABASE_URL=postgresql://postgres:password123@localhost:5432/badminton_dev